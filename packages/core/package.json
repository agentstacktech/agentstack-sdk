{
  "name": "@agentstack/sdk",
  "version": "0.4.13",
  "description": "AgentStack-SDK - Universal API client with modular architecture and Neural integration",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js",
      "require": "./dist/i18n/index.js"
    },
    "./i18n/useI18n": {
      "types": "./dist/i18n/useI18n.d.ts",
      "import": "./dist/i18n/useI18n.js",
      "require": "./dist/i18n/useI18n.js"
    },
    "./economy": {
      "types": "./dist/economy/index.d.ts",
      "import": "./dist/economy/index.js",
      "require": "./dist/economy/index.js"
    },
    "./finance": {
      "types": "./dist/finance/index.d.ts",
      "import": "./dist/finance/index.js",
      "require": "./dist/finance/index.js"
    },
    "./guidance": {
      "types": "./dist/guidance/index.d.ts",
      "import": "./dist/guidance/index.js",
      "require": "./dist/guidance/index.js"
    },
    "./guidance/react": {
      "types": "./dist/guidance/react/index.d.ts",
      "import": "./dist/guidance/react/index.js",
      "require": "./dist/guidance/react/index.js"
    },
    "./commerce/assets": {
      "types": "./dist/commerce/assets/index.d.ts",
      "import": "./dist/commerce/assets/index.esm.js",
      "require": "./dist/commerce/assets/index.js",
      "default": "./dist/commerce/assets/index.esm.js"
    },
    "./commerce/marketplace": {
      "types": "./dist/commerce/marketplace/index.d.ts",
      "import": "./dist/commerce/marketplace/index.esm.js",
      "require": "./dist/commerce/marketplace/index.js",
      "default": "./dist/commerce/marketplace/index.esm.js"
    },
    "./commerce/checkout": {
      "types": "./dist/commerce/checkout/index.d.ts",
      "import": "./dist/commerce/checkout/index.esm.js",
      "require": "./dist/commerce/checkout/index.js",
      "default": "./dist/commerce/checkout/index.esm.js"
    },
    "./commerce/cart": {
      "types": "./dist/commerce/cart/index.d.ts",
      "import": "./dist/commerce/cart/index.esm.js",
      "require": "./dist/commerce/cart/index.js",
      "default": "./dist/commerce/cart/index.esm.js"
    },
    "./commerce/orders": {
      "types": "./dist/commerce/orders/index.d.ts",
      "import": "./dist/commerce/orders/index.esm.js",
      "require": "./dist/commerce/orders/index.js",
      "default": "./dist/commerce/orders/index.esm.js"
    },
    "./commerce/shop": {
      "types": "./dist/commerce/shop/index.d.ts",
      "import": "./dist/commerce/shop/index.esm.js",
      "require": "./dist/commerce/shop/index.js",
      "default": "./dist/commerce/shop/index.esm.js"
    },
    "./commerce/merchant": {
      "types": "./dist/commerce/merchant/index.d.ts",
      "import": "./dist/commerce/merchant/index.esm.js",
      "require": "./dist/commerce/merchant/index.js",
      "default": "./dist/commerce/merchant/index.esm.js"
    },
    "./commerce/guidance": {
      "types": "./dist/commerce/guidance/index.d.ts",
      "import": "./dist/commerce/guidance/index.esm.js",
      "require": "./dist/commerce/guidance/index.js",
      "default": "./dist/commerce/guidance/index.esm.js"
    },
    "./commerce/participant": {
      "types": "./dist/commerce/participant/index.d.ts",
      "import": "./dist/commerce/participant/index.esm.js",
      "require": "./dist/commerce/participant/index.js",
      "default": "./dist/commerce/participant/index.esm.js"
    },
    "./commerce": {
      "types": "./dist/commerce/index.d.ts",
      "import": "./dist/commerce/index.esm.js",
      "require": "./dist/commerce/index.js",
      "default": "./dist/commerce/index.esm.js"
    },
    "./pwa": {
      "types": "./dist/pwa/index.d.ts",
      "import": "./dist/pwa/index.js",
      "require": "./dist/pwa/index.js"
    },
    "./mobile": {
      "types": "./dist/mobile/index.d.ts",
      "import": "./dist/mobile/index.js",
      "require": "./dist/mobile/index.js"
    },
    "./logic/blueprints": {
      "types": "./dist/logic/blueprints/index.d.ts",
      "import": "./dist/logic/blueprints/index.esm.js",
      "require": "./dist/logic/blueprints/index.js",
      "default": "./dist/logic/blueprints/index.esm.js"
    },
    "./capability-tasks": {
      "types": "./dist/capability-tasks/index.d.ts",
      "import": "./dist/capability-tasks/index.esm.js",
      "require": "./dist/capability-tasks/index.js",
      "default": "./dist/capability-tasks/index.esm.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "import": "./dist/manifest/index.esm.js",
      "require": "./dist/manifest/index.js",
      "default": "./dist/manifest/index.esm.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "sync:agentstack-version": "node ./scripts/sync-agentstack-core-version.mjs",
    "prebuild": "npm run sync:agentstack-version && npm run bundle:rnnoise-worklet",
    "bundle:rnnoise-worklet": "node ./scripts/bundle-rnnoise-worklet.mjs",
    "pretest": "npm run sync:agentstack-version",
    "pretype-check": "npm run sync:agentstack-version",
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.cjs",
    "test:integration:watch": "jest --config jest.integration.config.cjs --watch",
    "test:all": "npm run test && npm run test:integration",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "check:economy-parity": "node ../../scripts/check-sdk-economy-parity.mjs",
    "check:finance-parity": "node ../../scripts/check-sdk-finance-parity.mjs",
    "check:commerce-assets-parity": "node ../../scripts/check-sdk-commerce-assets-parity.mjs",
    "check:commerce-marketplace-parity": "node ../../scripts/check-sdk-commerce-marketplace-parity.mjs",
    "check:commerce-shop-parity": "node ../../scripts/check-commerce-shop-parity.mjs",
    "check:docs-urls": "node ./scripts/check-docs-urls.mjs",
    "check:package-exports": "node ./scripts/check-package-exports.mjs",
    "check:docs-api-symbols": "node ./scripts/check-docs-api-symbols.mjs",
    "check:openapi-sdk-sample": "node ./scripts/check-openapi-sdk-sample.mjs",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "agentstack",
    "agentstack-sdk",
    "sdk",
    "api",
    "client",
    "typescript",
    "payments",
    "analytics",
    "neural",
    "admin",
    "modular"
  ],
  "author": "AgentStack Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentstacktech/agentstack-sdk.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/agentstacktech/agentstack-sdk/issues"
  },
  "homepage": "https://github.com/agentstacktech/agentstack-sdk#readme",
  "devDependencies": {
    "@jsquash/avif": "^1.3.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/webp": "^1.5.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/react": "18.3.26",
    "@types/use-sync-external-store": "^1.5.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "blurhash": "^2.0.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.19.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.0",
    "rollup": "^4.30.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-terser": "^7.0.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@jsquash/avif": "^1.3.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/webp": "^1.4.0",
    "blurhash": "^2.0.5",
    "photoswipe": "^5.4.0",
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "photoswipe": {
      "optional": true
    },
    "@jsquash/avif": {
      "optional": true
    },
    "@jsquash/webp": {
      "optional": true
    },
    "@jsquash/jpeg": {
      "optional": true
    },
    "blurhash": {
      "optional": true
    }
  },
  "dependencies": {
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "eventemitter3": "^5.0.1",
    "tslib": "^2.8.0",
    "use-sync-external-store": "^1.6.0",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
